# =============================================================================
# FleetSight Environment Configuration
# Copy this file to .env and fill in actual values.
# NEVER commit .env to version control.
# =============================================================================

# --- Application ---
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=INFO

# --- Backend / FastAPI ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# --- Database (PostgreSQL + PostGIS) ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=fleetsight
DATABASE_USER=fleetsight
DATABASE_URL=postgresql+asyncpg://fleetsight:changeme@localhost:5432/fleetsight

# --- ML / Model Configuration ---
# Supported models: yolo11, yolo12, yolo26
FLEETSIGHT_DETECTOR_FAMILY=ultralytics
FLEETSIGHT_DETECTOR_MODEL=yolo11
FLEETSIGHT_DETECTOR_WEIGHTS_PATH=
FLEETSIGHT_DETECTOR_CONFIDENCE_THRESHOLD=0.25
FLEETSIGHT_DETECTOR_DEVICE=cpu

# --- Edge ---
EDGE_EVENT_CACHE_DIR=./data/edge_cache
EDGE_GPS_POLL_INTERVAL_MS=1000

# --- Privacy ---
PRIVACY_BLUR_FACES=true
PRIVACY_BLUR_PLATES=true
